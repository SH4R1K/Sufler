<Window x:Class="Sufler.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:media="clr-namespace:System.Windows.Media;assembly=PresentationCore"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sufler"
        AllowsTransparency="True"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#B3000000"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- WindowChrome.SetWindowChrome(this, chrome) in attached-property form. AllowsTransparency
         requires WindowStyle="None"; the chrome keeps a 6 px invisible resize frame around the
         window and asks for no caption, because the thin strip below does the dragging. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid"
          Background="Transparent"
          MouseEnter="OnPrompterMouseEnter"
          MouseLeave="OnPrompterMouseLeave">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Drag handle. Deliberately transparent: it is a 18 px strip, not a title bar. -->
        <Border x:Name="DragStrip"
                Grid.Row="0"
                Height="18"
                Background="Transparent"
                Cursor="SizeAll"
                MouseLeftButtonDown="OnDragStripMouseLeftButtonDown" />

        <Grid Grid.Row="1">
            <!-- The prompter must have no visible scrollbars, hence Hidden rather than Visible.
                 It must not be Disabled, though: "Disabled" does not merely hide the bars, it turns
                 scrolling off, the content gets measured against the viewport height instead of its
                 own, ExtentHeight collapses onto ViewportHeight and ScrollableHeight stays 0 — so
                 the wheel, the arrows and ScrollToVerticalOffset all move nothing. "Hidden" keeps
                 the same bare look and still scrolls. -->
            <ScrollViewer x:Name="Scroller"
                          CanContentScroll="False"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Hidden"
                          Focusable="False">
                <TextBlock x:Name="ScriptTextBlock"
                           Margin="24,4,24,12"
                           TextWrapping="Wrap"
                           Foreground="White"
                           FontFamily="Segoe UI"
                           FontSize="36">
                    <!-- Per-glyph shadow: cheaper than a bitmap Effect and keeps the glyphs
                         readable over a bright slide or a bright window behind the prompter. -->
                    <TextBlock.TextEffects>
                        <media:TextEffect>
                            <media:TextEffect.Transform>
                                <media:TranslateTransform X="1" Y="1" />
                            </media:TextEffect.Transform>
                            <media:TextEffect.Foreground>
                                <SolidColorBrush Color="#99000000" />
                            </media:TextEffect.Foreground>
                        </media:TextEffect>
                    </TextBlock.TextEffects>
                </TextBlock>
            </ScrollViewer>

            <TextBlock x:Name="EmptyHint"
                       Margin="24"
                       Text="Текст пуст — откройте «Сценарий» (Ctrl+Alt+T) и вставьте текст (Ctrl+V)"
                       Foreground="#A6FFFFFF"
                       FontSize="18"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False" />
        </Grid>

        <!-- Status strip: hover affordance. IsHitTestVisible is left on so it participates in
             hover, but it lives in its own row below the text, so it never covers a click
             aimed at the script, and it is not focusable. -->
        <Border x:Name="StatusStrip"
                Grid.Row="2"
                Opacity="0.45"
                Focusable="False">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,2,0,6">
                <TextBlock x:Name="SpeedText"
                           Foreground="#E6FFFFFF"
                           FontSize="12"
                           Margin="0,0,16,0" />
                <TextBlock x:Name="PixelsText"
                           Foreground="#99FFFFFF"
                           FontSize="12"
                           Margin="0,0,16,0" />
                <TextBlock x:Name="StateText"
                           Foreground="#E6FFFFFF"
                           FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</Window>