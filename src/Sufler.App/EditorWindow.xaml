<Window x:Class="Sufler.App.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sufler — сценарий"
        Width="980"
        Height="720"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#FFF3F3F3"
        UseLayoutRounding="True">

    <DockPanel Margin="12">
        <!-- This window is deliberately NOT excluded from screen capture: it is a control panel,
             so its own content shows up in recordings and streams. -->
        <TextBlock DockPanel.Dock="Top"
                   Text="Это окно попадает в запись экрана. Во время демонстрации закрывайте его."
                   TextWrapping="Wrap"
                   Foreground="#FF8A1F1F"
                   FontSize="12"
                   Margin="0,0,0,10" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="430" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Ctrl+V is the framework's own paste, no interception needed. -->
            <TextBox x:Name="ScriptTextBox"
                     Grid.Column="0"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas"
                     FontSize="14"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     HorizontalContentAlignment="Left"
                     SpellCheck.IsEnabled="False"
                     TextChanged="OnScriptTextChanged" />

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,6,0">
                <StackPanel Margin="4,0,0,0">

                    <TextBlock Text="Шрифт" FontWeight="SemiBold" />
                    <ComboBox x:Name="FontFamilyBox"
                              Margin="0,4,0,6"
                              DisplayMemberPath="Source"
                              SelectionChanged="OnFontFamilyChanged" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="FontSizeSlider"
                                Grid.Column="0"
                                Minimum="12"
                                Maximum="120"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="OnFontSizeChanged" />
                        <TextBlock x:Name="FontSizeValueText"
                                   Grid.Column="1"
                                   MinWidth="34"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right" />
                    </Grid>

                    <Separator Margin="0,8,0,0" />
                    <TextBlock Text="Скорость" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SpeedSlider"
                                Grid.Column="0"
                                Minimum="5"
                                Maximum="120"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="OnSpeedChanged" />
                        <TextBlock x:Name="SpeedValueText"
                                   Grid.Column="1"
                                   MinWidth="96"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right" />
                    </Grid>

                    <Separator Margin="0,8,0,0" />
                    <TextBlock Text="Прозрачность" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="OpacitySlider"
                                Grid.Column="0"
                                Minimum="0.1"
                                Maximum="1.0"
                                TickFrequency="0.05"
                                ValueChanged="OnOpacityChanged" />
                        <TextBlock x:Name="OpacityValueText"
                                   Grid.Column="1"
                                   MinWidth="52"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right" />
                    </Grid>

                    <Separator Margin="0,8,0,0" />
                    <CheckBox x:Name="LoopCheckBox"
                              Content="Зацикливание"
                              Margin="0,8,0,0"
                              Checked="OnLoopChanged"
                              Unchecked="OnLoopChanged" />

                    <Separator Margin="0,8,0,0" />
                    <TextBlock Text="Невидимость" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <TextBlock x:Name="CaptureStatusText"
                               Text="неизвестно"
                               TextWrapping="Wrap"
                               Foreground="#FF3C3C3C"
                               FontSize="12" />

                    <Separator Margin="0,8,0,0" />
                    <TextBlock Text="Скрипты" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <ListBox x:Name="ScriptListBox"
                             Height="140"
                             DisplayMemberPath="DisplayName" />
                    <TextBlock x:Name="ScriptsEmptyText"
                               Text="Сохранённых сценариев пока нет"
                               Foreground="#FF6A6A6A"
                               FontSize="12"
                               Margin="0,4,0,0"
                               Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Загрузить"
                                Padding="10,3"
                                Margin="0,0,6,0"
                                Click="OnLoadScriptClick" />
                        <Button Content="Сохранить как…"
                                Padding="10,3"
                                Click="OnSaveScriptAsClick" />
                    </StackPanel>

                    <Separator Margin="0,8,0,0" />
                    <TextBlock Text="Размер окна суфлёра" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <!-- Minimum/Maximum/TickFrequency are assigned in EditorWindow.xaml.cs from the
                         Min/Max/Step constants, so the markup keeps no copy of those numbers. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Ширина, точек"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,4" />
                        <Slider x:Name="WindowWidthSlider"
                                Grid.Row="0" Grid.Column="1"
                                Margin="0,0,0,4"
                                IsSnapToTickEnabled="True"
                                ValueChanged="OnWindowWidthSliderChanged" />
                        <TextBlock x:Name="WindowWidthValueText"
                                   Grid.Row="0" Grid.Column="2"
                                   MinWidth="72"
                                   Margin="8,0,0,4"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right" />
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Высота, точек"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <Slider x:Name="WindowHeightSlider"
                                Grid.Row="1" Grid.Column="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="OnWindowHeightSliderChanged" />
                        <TextBlock x:Name="WindowHeightValueText"
                                   Grid.Row="1" Grid.Column="2"
                                   MinWidth="72"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right" />
                    </Grid>
                    <Button Content="По умолчанию"
                            Margin="0,6,0,0"
                            Padding="10,3"
                            HorizontalAlignment="Left"
                            Click="OnResetWindowSizeClick" />
                    <TextBlock Text="Ширина 320–3840, высота 240–2160 точек, шаг 10. «По умолчанию» возвращает размер по умолчанию — 720×540."
                               TextWrapping="Wrap"
                               Foreground="#FF6A6A6A"
                               FontSize="12"
                               Margin="0,4,0,0" />

                    <Separator Margin="0,8,0,0" />
                    <TextBlock Text="Горячие клавиши" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <StackPanel x:Name="HotKeyRowsPanel" Margin="0,0,0,12" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>